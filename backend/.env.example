DEBUG=false
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
PYTHON_BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL / database (Supabase Postgres is used only as the app database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ur_past_paper

# Application JWT
JWT_SECRET_KEY=replace-with-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google One Tap / OIDC used to validate Google ID tokens and then issue the app JWT
# REQUIRED for Google login, BACKEND-ONLY: must be exactly https://accounts.google.com.
OIDC_ISSUER_URL=https://accounts.google.com
# REQUIRED for Google login, BACKEND-ONLY: the same Google Web client ID supplied to VITE_GOOGLE_CLIENT_ID.
OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# OPTIONAL, BACKEND-ONLY SECRET: not read by the current Google One Tap token-exchange flow; reserve for a future server-side authorization-code flow.
OIDC_CLIENT_SECRET=replace-with-google-client-secret
# OPTIONAL, BACKEND-ONLY: requested scopes for dormant OIDC authorization helpers; not used by the current One Tap exchange.
OIDC_SCOPE=openid email profile

# Google Drive storage provider
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Email/password reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=UR Academic Resource Hub
# OPTIONAL, BACKEND-ONLY: reply/support address shown in branded transactional emails. Defaults to SMTP_FROM_EMAIL.
SUPPORT_EMAIL=support@example.com
# REQUIRED in production: keep false so reset links are never returned in API responses.
EXPOSE_PASSWORD_RESET_LINKS=false
# OPTIONAL, BACKEND-ONLY: reset-token lifetime in minutes. Defaults to 30.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# AI provider configuration (backend only; only required when AI features are enabled)
AI_ENABLED=false
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_CONTEXT_TOKENS=12000
AI_MAX_REQUESTS_PER_USER_PER_MINUTE=5
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_COMPATIBLE_EMBEDDING_MODEL=

# Admin bootstrap
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_ID=

# Runtime / deployment controls
ALLOW_RUNTIME_ENV_MUTATION=false
URHUD_AUTO_CREATE_TABLES=true
URHUD_IGNORE_INIT_ADMIN=false
URHUD_IGNORE_INIT_DATA=false
