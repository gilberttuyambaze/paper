DEBUG=false
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
PYTHON_BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL / database (Supabase Postgres is used only as the app database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ur_past_paper

# Application JWT
JWT_SECRET_KEY=replace-with-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google One Tap / OIDC used to validate Google ID tokens and then issue the app JWT
# REQUIRED for Google login, BACKEND-ONLY: must be exactly https://accounts.google.com.
OIDC_ISSUER_URL=https://accounts.google.com
# REQUIRED for Google login, BACKEND-ONLY: the same Google Web client ID supplied to VITE_GOOGLE_CLIENT_ID.
OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# OPTIONAL, BACKEND-ONLY SECRET: not read by the current Google One Tap token-exchange flow; reserve for a future server-side authorization-code flow.
OIDC_CLIENT_SECRET=replace-with-google-client-secret
# OPTIONAL, BACKEND-ONLY: requested scopes for dormant OIDC authorization helpers; not used by the current One Tap exchange.
OIDC_SCOPE=openid email profile

# Google Drive storage provider
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Transactional email via Brevo API (backend-only secret)
BREVO_API_KEY=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=UR Academic Resource Hub
# OPTIONAL, BACKEND-ONLY: reply/support address shown in branded transactional emails. Defaults to SMTP_FROM_EMAIL.
SUPPORT_EMAIL=support@example.com
# OPTIONAL, BACKEND-ONLY: reset-token lifetime in minutes. Defaults to 30.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# OPTIONAL, BACKEND-ONLY: inactivity reminder threshold. Defaults to 5 days.
INACTIVE_USER_THRESHOLD_DAYS=5

# ==============================================================================
# AI Study Assistant & Academic Copilot Configuration (Backend Only)
# ==============================================================================
# Enable or disable AI assistant features
AI_ENABLED=true

# Primary preferred provider (e.g. groq, gemini, openai, openrouter)
AI_PROVIDER=groq

# ------------------------------------------------------------------------------
# 4-Stage Waterfall Failover Chain
# ------------------------------------------------------------------------------
# The backend automatically skips any provider whose API key is absent, cascading:
#   1. Groq (Fastest OSS) -> 2. Gemini -> 3. OpenAI -> 4. OpenRouter
# If a provider hits a 429 rate limit or timeout, it enters a 5-minute cooldown
# and subsequent prompts in that user session immediately bypass it with 0ms delay.
AI_FALLBACK_CHAIN=groq,gemini,openai,openrouter

# 1. Groq Cloud (Ultra-fast inference: openai/gpt-oss-120b or openai/gpt-oss-20b)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 2. Google Gemini (Gemini 3.6 Flash / 3.1 Flash-Lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 3. OpenAI (GPT-4.1 mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1

# 4. OpenRouter (Multi-model aggregation gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Performance & Token Budgets
AI_TIMEOUT_SECONDS=12.0
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_TOKENS=16000
AI_MAX_REQUESTS_PER_USER_PER_MINUTE=60

# Custom OpenAI-Compatible Endpoint (Local Ollama, vLLM, LMStudio, etc.)
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_COMPATIBLE_EMBEDDING_MODEL=

# Passage retrieval / hybrid RAG. Set EMBEDDING_PROVIDER=disabled to retain
# keyword-only retrieval while passages continue to be stored.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
VECTOR_SEARCH_TOP_K=5
HYBRID_SEARCH_TOP_K=40
RAG_CONTEXT_LIMIT=5

# Admin bootstrap
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_ID=

# Runtime / deployment controls
ALLOW_RUNTIME_ENV_MUTATION=false
URHUD_AUTO_CREATE_TABLES=true
URHUD_IGNORE_INIT_ADMIN=false
URHUD_IGNORE_INIT_DATA=false
