DEBUG=false
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
PYTHON_BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL / database (Supabase Postgres is used only as the app database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ur_past_paper

# Application JWT
JWT_SECRET_KEY=replace-with-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google OAuth / OIDC used to validate Google sign-in and then issue the app JWT
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=replace-with-google-client-secret
OIDC_SCOPE=openid email profile

# Google Drive storage provider
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Email/password reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=UR Academic Resource Hub
EXPOSE_PASSWORD_RESET_LINKS=false

# AI provider configuration (backend only; only required when AI features are enabled)
AI_ENABLED=false
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_CONTEXT_TOKENS=12000
AI_MAX_REQUESTS_PER_USER_PER_MINUTE=20
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_COMPATIBLE_EMBEDDING_MODEL=

# Admin bootstrap
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_ID=

# Runtime / deployment controls
ALLOW_RUNTIME_ENV_MUTATION=false
URHUD_AUTO_CREATE_TABLES=true
URHUD_IGNORE_INIT_ADMIN=false
URHUD_IGNORE_INIT_DATA=false
