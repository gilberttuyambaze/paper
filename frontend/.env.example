# Frontend environment template for this project.
# Documentation only. Do not store real credentials here.

# Required for backend API calls
VITE_API_BASE_URL=http://localhost:8000

# REQUIRED for Google Sign-In button/init in the browser. This public Web client ID must match Render's OIDC_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
